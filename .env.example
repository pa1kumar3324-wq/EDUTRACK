# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used only by scripts/seed.ts (server-side, never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public URL of THIS deployment. Required in production (Vercel) —
# used to build the volunteer-invite email link (/api/volunteers) so it
# never points at localhost or an unintended host. Local dev falls back to
# http://localhost:3000 automatically if this is left unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Official Emporum website (https only). When set, "Emporum" in the app footer and on
# the sign-in screens links to it; when unset or invalid, the credit shows as plain text.
# Optional override; defaults to https://emporum.netlify.app/
# NEXT_PUBLIC_EMPORUM_URL=https://emporum.netlify.app/
